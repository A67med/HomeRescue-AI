# Copy to .env and edit for your local machine. Never commit .env.
# Target database name (used by src/db.py when SQLSERVER_CONN is not explicitly set, or to override database in M5 verification):
SQLSERVER_SERVER=localhost
SQLSERVER_DB=homerescue_dw

# Windows authentication (default):
SQLSERVER_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=homerescue_dw;Trusted_Connection=yes;TrustServerCertificate=yes;

# SQL login alternative (do not put real passwords in .env.example):
# SQLSERVER_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=homerescue_dw;UID=<your_sql_user>;PWD=<your_sql_password>;TrustServerCertificate=yes;
